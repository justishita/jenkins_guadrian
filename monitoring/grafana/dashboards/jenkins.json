{
  "uid": "jenkins-ci",
  "title": "Jenkins",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "jenkins-guardian"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Builds per branch and branch health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_available_builds_count",
          "legendFormat": "{{jenkins_job}} builds"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(default_jenkins_builds_last_build_result_ordinal == 2) or vector(0)",
          "legendFormat": "branches whose last build failed"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(default_jenkins_builds_last_build_result_ordinal == 0) or vector(0)",
          "legendFormat": "branches whose last build passed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Last build duration (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_duration_milliseconds",
          "legendFormat": "{{jenkins_job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last build result (0=ok,1=unstable,2=fail)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_result_ordinal",
          "legendFormat": "{{jenkins_job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jenkins_queue_size_value",
          "legendFormat": "queue"
        }
      ]
    }
  ]
}