{
  "uid": "jenkins-ci",
  "title": "Jenkins",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "jenkins-guardian"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Builds by result (total)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(default_jenkins_builds_success_build_count)",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(default_jenkins_builds_failed_build_count)",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Last build duration (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_duration_milliseconds",
          "legendFormat": "{{jobname}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last build result (0=ok,1=unstable,2=fail)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "default_jenkins_builds_last_build_result_ordinal",
          "legendFormat": "{{jobname}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jenkins_queue_size_value",
          "legendFormat": "queue"
        }
      ]
    }
  ]
}