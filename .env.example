JENKINS_URL=
JENKINS_ADMIN_USER=
JENKINS_ADMIN_PASSWORD=
JENKINS_USER=
JENKINS_API_TOKEN=

GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_USERNAME=
GITHUB_CREDENTIALS_ID=

GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_OFFLINE=0
LLM_REQUESTS_PER_MINUTE=10
LLM_TIMEOUT_SECONDS=30
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

WEBHOOK_SHARED_SECRET=
# Bearer token for the /approvals API (P3). Empty disables approvals.
APPROVAL_API_TOKEN=
CATCHUP_ENABLED=true

PROMETHEUS_URL=

# Policy guardrails (P3). OPA serves the bundle in ./policies.
OPA_URL=http://opa:8181
POLICY_TIMEOUT_SECONDS=5

# Code & Remediation agent (P3)
CODE_AGENT_QUEUE_NAME=code_agent.incident.created
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=10
EVIDENCE_DIR=data/evidence
AUDIT_DIR=data/audit

DOCKER_GID=

RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_URL=

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
ORDERS_ENABLE_SLOW=
ORDERS_ENABLE_CPU=
ORDERS_ENABLE_LEAK=

# Architecture & Messaging (New Foundation)
BLACKBOARD_BACKEND=file
TRIGGER_MODE=a2a
PROMPT_VARIANT=react
A2A_SHARED_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_CONSOLE=0
MCP_JENKINS_URL=
MCP_ANALYTICS_URL=

# Notifications & Approvals (Mailhog for local demos on port 8025 / SMTP 1025)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
NOTIFICATION_EMAIL_FROM=alerts@jenkinsguardians.local
NOTIFICATION_EMAIL_TO=devops@jenkinsguardians.local
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- Web UI (login, projects, reports, reviews) ---
# 32+ random characters; sign-in is disabled until it is set.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
UI_SESSION_SECRET=
# The first admin account is created from these when the users table is empty.
UI_ADMIN_EMAIL=
UI_ADMIN_PASSWORD=
# Set to true when the UI is served over HTTPS.
UI_COOKIE_SECURE=false
# Where the browser reaches Grafana: through the UI's authenticated /grafana/ proxy.
GRAFANA_PUBLIC_URL=http://localhost:3001/grafana
